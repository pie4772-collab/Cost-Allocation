# 환경 변수 예시 — OCI VM + PostgreSQL (Supabase 불필요)

# ─── PostgreSQL ───────────────────────────────────────────────
# Docker Compose 로컬:
DATABASE_URL="postgresql://costapp:costapp@localhost:5432/cost_allocation?schema=public"

# OCI VM (같은 VM에 PostgreSQL 설치 시):
# DATABASE_URL="postgresql://costapp:YOUR_PASSWORD@localhost:5432/cost_allocation?schema=public"

# ─── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Session (필수 — production) ───────────────────────────────
# openssl rand -base64 32 로 생성
SESSION_SECRET="change-this-to-a-random-string-min-16-chars"

# ─── Seed ──────────────────────────────────────────────────────
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ─── Local dev only (로그인 생략) ─────────────────────────────
# AUTH_DISABLED=true
# DEV_USER_ID=""

# 연결 확인: npm run db:check
# 배포 가이드: docs/DEPLOYMENT.md
