{
  "name": "cost-allocation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:lan": "next dev --turbopack -H 0.0.0.0 -p 3000",
    "dev:webpack": "next dev",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:import-excel": "tsx --env-file=.env scripts/import-excel-to-db.ts",
    "db:check": "tsx scripts/check-db.ts",
    "db:setup-local": "powershell -ExecutionPolicy Bypass -File scripts/setup-local-postgres.ps1",
    "db:export-supabase": "powershell -ExecutionPolicy Bypass -File scripts/export-supabase.ps1",
    "db:migrate-supabase": "powershell -ExecutionPolicy Bypass -File scripts/migrate-supabase-to-local.ps1",
    "db:restore-local": "powershell -ExecutionPolicy Bypass -File scripts/restore-local-postgres.ps1",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.5.0",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jose": "^6.0.11",
    "lucide-react": "^0.477.0",
    "next": "^15.2.0",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/bcryptjs": "^2.4.6",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.0",
    "tsx": "^4.19.3",
    "vitest": "^3.0.7"
  }
}
